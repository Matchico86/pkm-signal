# SQLite
PKM_DB_PATH=db/pkm-market-engine.db

# Portal stock import (V1 operational feed for targets + portal_stock_snapshot)
PKM_PORTAL_STOCK_FILE=data/export/portal-stock.json

# Portal snapshot import (detailed raw ingestion)
PKM_PORTAL_SNAPSHOT_FILE=data/export/portal-snapshot.json
PKM_PORTAL_SNAPSHOT_URL=
PKM_PORTAL_SNAPSHOT_TOKEN=

# Market ingestion
PKM_MARKET_DAILY_FILE=data/export/market-daily.json
PKM_POKEMONTCG_API_BASE_URL=https://api.pokemontcg.io/v2/
PKM_POKEMONTCG_API_KEY=
PKM_POKEMONTCG_TIMEOUT_MS=15000
PKM_POKEMONTCG_MAX_RETRIES=2
PKM_USD_TO_EUR_RATE=

# Scoring overrides (JSON string, optional)
PKM_SCORING_CONFIG_JSON=

# POC FR Strict - RapidAPI (CardMarket)
CARDMARKET_RAPIDAPI_KEY=
CARDMARKET_RAPIDAPI_HOST=
RAPIDAPI_LIVE_CALLS_ENABLED=false
RAPIDAPI_MAX_REQUESTS_PER_RUN=3
RAPIDAPI_MAX_REQUESTS_PER_DAY=10
RAPIDAPI_MIN_REMAINING_REQUIRED=85
RAPIDAPI_RATE_LIMIT_PER_MINUTE=5

# POC FR Strict - SerpApi (Google Trends)
SERPAPI_KEY=
SERPAPI_LIVE_CALLS_ENABLED=false
SERPAPI_MAX_REQUESTS_PER_RUN=3
SERPAPI_MAX_REQUESTS_PER_DAY=10

# POC FR Strict - Global Market Params
SIGNAL_MARKET_COUNTRY=FR
SIGNAL_MARKET_CURRENCY=EUR
SIGNAL_TRENDS_GEO=FR
SIGNAL_TRENDS_HL=fr

# eBay Observation Configuration
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_LIVE_CALLS_ENABLED=false
EBAY_MAX_REQUESTS_PER_RUN=3
EBAY_MAX_REQUESTS_PER_DAY=10
EBAY_MIN_REMAINING_REQUIRED=5
