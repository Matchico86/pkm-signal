{
  "name": "pkm-market-engine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:worker": "npx @dotenvx/dotenvx run -- node src/worker.js",
    "db:migrate": "node src/db/migrate.js",
    "db:migrate:status": "node src/db/migrate.js --status",
    "portal:import": "node src/connectors/portal/import-snapshot.js",
    "portal:import:legacy-stock": "node src/connectors/portal/import-stock.js",
    "portal:import:v1": "npm run portal:import:legacy-stock",
    "import:portal": "npm run portal:import",
    "market:import": "node src/connectors/market/import-daily.js",
    "market:snapshot": "node src/jobs/market-snapshot.js",
    "scores:daily": "node src/jobs/scores-daily.js",
    "alerts:daily": "node src/jobs/alerts-daily.js"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "@supabase/supabase-js": "^2.107.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  }
}
